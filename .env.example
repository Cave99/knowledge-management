# The folder containing your existing Markdown files. Defaults to ./knowledge.
CONTENT_DIR=./knowledge
# API port in development; the complete application port in production.
PORT=3001

# Server-only API keys. Leave blank to keep ordinary search without AI.
OPENROUTER_API_KEY=
INCEPTION_API_KEY=

# OpenRouter is used only for embeddings; answers use Inception directly.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024
INCEPTION_MODEL=mercury-3

# Persistent embedded Postgres/pgvector index. One server process per directory.
AI_DATA_DIR=./.data/ai
